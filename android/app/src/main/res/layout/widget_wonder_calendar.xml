<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/iv_wonder_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wonder_calendar_shell" />

    <ImageView
        android:id="@+id/iv_wonder_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1000">

        <!-- 1. 上方屏幕与机身区 (Y: 0 ~ 745)：单击直接打开软件首页 -->
        <FrameLayout
            android:id="@+id/zone_card_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="745"
            android:clickable="true" />

        <!-- 2. 底部四个按键热区行 (Y: 745 ~ 965) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="220"
            android:orientation="horizontal"
            android:weightSum="1000">

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="210" />
            <FrameLayout android:id="@+id/btn_prev_month" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="158" android:clickable="true" />
            <FrameLayout android:id="@+id/btn_next_month" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="152" android:clickable="true" />
            <FrameLayout android:id="@+id/btn_back_today" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="155" android:clickable="true" />
            <FrameLayout android:id="@+id/btn_quick_note" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="180" android:clickable="true" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="145" />
        </LinearLayout>

        <!-- 3. 底部边缘留白 (965 ~ 1000) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="35" />
    </LinearLayout>
</FrameLayout>
